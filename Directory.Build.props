<Project>
  <!--
    Shared build settings for every project in the solution.
    TargetFramework and LangVersion are intentionally pinned in each .csproj (not here)
    so every project states its own target explicitly.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: the build fails on any warning, including analyzer and style warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Required for IDE0005 (unnecessary usings) and for public API documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Reported as OpenTelemetry service.version (the SDK appends +<commit> inside a git repository). -->
    <Version>1.0.0</Version>
    <Authors>ModularMonolith contributors</Authors>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
