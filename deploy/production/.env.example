# Copy to deploy/production/.env (git-ignored). Non-secret settings only; secrets are files in
# deploy/production/secrets/ (see docker-compose.keycloak.yml).

# Public host name of Keycloak (no scheme), e.g. id.example.com. The TLS certificate must match it.
KEYCLOAK_HOSTNAME=id.example.com

# Public base URL of the API / browser login (redirect URIs of the web client), no trailing slash.
APP_PUBLIC_URL=https://api.example.com

# SMTP for e-mail verification and password reset (the password is the smtp_password secret file).
KC_SMTP_HOST=smtp.example.com
KC_SMTP_PORT=587
KC_SMTP_FROM=no-reply@example.com
KC_SMTP_USER=no-reply@example.com
