# Copy to deploy/.env (git-ignored) to change non-secret settings.
# Passwords are NOT configured here: run deploy/init-secrets.ps1 (or bash deploy/init-secrets.sh),
# which writes them to deploy/secrets/ for Docker secrets.
ASPNETCORE_ENVIRONMENT=Development

# Keycloak's bootstrap admin (development console only; Keycloak reads it from the environment).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
