{
  "AllowedHosts": "*",
  "Database": {
    "ConnectionStringName": "postgres",
    "ApplicationRole": "modular_monolith_app",
    "MigrateOnStartup": true
  },
  "Authentication": {
    "Audience": "modular-monolith-api",
    "WebClientId": "modular-monolith-web"
  },
  "Tenancy": {
    "ClaimType": "tenant_id",
    "AllowDefaultTenant": false,
    "DefaultTenant": "default",
    "RootDomain": null
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxBatchesPerRun": 20,
    "MaxAttempts": 8,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 3600,
    "SweepCron": "* * * * *"
  },
  "FeatureManagement": {
    "BetaOnboarding": false,
    "CatalogWriteDisabled": false
  },
  "Localization": {
    "SupportedCultures": [ "en" ]
  },
  "Modules": {
    "Catalog": {
      "ProductCacheSeconds": 60,
      "ExchangeRateCacheSeconds": 600,
      "ExchangeRatesBaseUrl": "https://open.er-api.com"
    },
    "Identity": {
      "Authority": null
    }
  },
  "RateLimiting": {
    "PermitLimit": 100
  },
  "Observability": {
    "LokiUrl": "",
    "TempoEndpoint": "",
    "OtlpMetrics": false,
    "OtlpLogs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  }
}
