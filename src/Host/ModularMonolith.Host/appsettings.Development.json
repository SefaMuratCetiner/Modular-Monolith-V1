{
  "ConnectionStrings": {
    "cache": "localhost:6379"
  },
  "DataProtection": {
    "RequireEncryptionAtRest": false
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/modular-monolith",
    "RequireHttpsMetadata": false
  },
  "Tenancy": {
    "AllowDefaultTenant": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
