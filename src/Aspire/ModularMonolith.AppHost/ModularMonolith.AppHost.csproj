<Project Sdk="Aspire.AppHost.Sdk/13.3.5">

  <!-- Local orchestration: PostgreSQL, Valkey, Keycloak, Grafana LGTM stack and the API host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModularMonolith.AppHost</RootNamespace>
    <UserSecretsId>modular-monolith-apphost</UserSecretsId>
    <!--
      No lock file: the Aspire SDK adds orchestration and dashboard packages for the developer machine's
      runtime identifier (e.g. Aspire.Hosting.Orchestration.win-x64), so a lock file written on Windows
      fails locked restore on Linux. The AppHost is a local development tool and never deployed;
      its versions are still pinned centrally in Directory.Packages.props.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Host\ModularMonolith.Host\ModularMonolith.Host.csproj" />
  </ItemGroup>

</Project>
