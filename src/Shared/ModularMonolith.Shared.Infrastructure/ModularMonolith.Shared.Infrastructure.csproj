<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reusable building blocks shared by all modules: module registration, data access with RLS,
    unit of work, CQRS decorators, outbox/inbox, in-process event bus, tenancy, caching,
    idempotency, localization and web conventions. It must never reference a module.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModularMonolith.Shared.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularMonolith.Shared.Kernel\ModularMonolith.Shared.Kernel.csproj" />
  </ItemGroup>

</Project>
