<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Package source mapping: every package id must map to a source, so a package can never be pulled
    from an unexpected feed (dependency confusion). When adding a private feed, map your own prefix to it,
    e.g. <package pattern="MyCompany.*" /> under that source.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
